<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>chuo</AssemblyName>
    <RootNamespace>Chuo.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- プラグインを動的に読み込むため、NativeAOT ではなく ReadyToRun を使う（設計 1 章） -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chuo.Core\Chuo.Core.csproj" />
    <ProjectReference Include="..\Chuo.Platform.Windows\Chuo.Platform.Windows.csproj" />
    <ProjectReference Include="..\Chuo.Platform.Linux\Chuo.Platform.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <!--
    同梱プラグインを、出力先の plugins/<プロジェクト名>/ に発行する。
    本体の発行時の RuntimeIdentifier や SelfContained はプラグインに引き継がない（ランタイムは本体のものを使う）。
  -->
  <ItemGroup>
    <BundledPlugin Include="..\..\plugins\*\*.csproj" />
    <!-- 復元とビルドの順序のためだけに参照する（アセンブリは参照しない） -->
    <ProjectReference Include="@(BundledPlugin)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="BuildBundledPlugins" AfterTargets="Build">
    <MSBuild Projects="@(BundledPlugin)" Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$([System.IO.Path]::GetFullPath('$(OutDir)'))plugins/%(BundledPlugin.Filename)/"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishReadyToRun;_IsPublishing" />
  </Target>

  <!--
    SkiaSharp と HarfBuzzSharp のパッケージに入っているネイティブの pdb（合わせて約 100MB）は発行しない。
    ネイティブのクラッシュダンプを解析するときにしか使わない。chuo 自身の pdb は、ログの例外に行番号を出すために残す。
  -->
  <Target Name="ExcludeNativePdbFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' and ('%(Filename)' == 'libSkiaSharp' or '%(Filename)' == 'libHarfBuzzSharp')" />
    </ItemGroup>
  </Target>

  <Target Name="PublishBundledPlugins" AfterTargets="Publish">
    <MSBuild Projects="@(BundledPlugin)" Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)'))plugins/%(BundledPlugin.Filename)/"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishReadyToRun;_IsPublishing" />
  </Target>

</Project>
